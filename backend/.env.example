# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set true whenever HTTPS terminates at the application-facing domain.
SESSION_SECURE=true
# Comma-separated browser origins allowed to make credentialed requests.
CORS_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
