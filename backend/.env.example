# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/invest_assistant

# LLM 配置
LLM_PROVIDER=anthropic  # 可选: anthropic / openai

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
