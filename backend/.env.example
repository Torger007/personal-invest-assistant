# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/invest_assistant

# LLM 配置
LLM_PROVIDER=anthropic  # 可选: anthropic / openai

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=  # 留空用默认 https://api.anthropic.com，代理时填写

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=  # 留空用默认 https://api.openai.com，代理/Azure/本地模型时填写