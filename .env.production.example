# PostgreSQL：密码如含 @、:、/、?、# 等字符，DATABASE_URL 中须作 URL 编码。
POSTGRES_DB=invest_assistant
POSTGRES_USER=invest_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://invest_app:replace-with-a-long-random-password@postgres:5432/invest_assistant

# 对外 HTTP 端口；生产环境建议由 HTTPS 反向代理转发到此端口。
APP_PORT=8080
TZ=Asia/Shanghai

DEBUG=false
SESSION_SECURE=true
CORS_ORIGINS=https://invest.example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# 二选一：只填写实际使用的 Provider 密钥。
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=

# 开关关闭时保留旧的固定规划路径；异常时新路径也会自动回退。
CONSTRAINED_AGENT_ENABLED=true

# 由 Compose 固定覆盖；保留在这里是为了配置意图清晰。
RUN_MIGRATIONS_ON_STARTUP=false
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
